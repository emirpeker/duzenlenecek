<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER" prefHeight="60.0" prefWidth="200.0" spacing="10" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.CounterController">

    <children>
        <Label text="Counter" />

        <TextField fx:id="counterField" editable="false" prefWidth="100" text="0" />

        <Button onAction="#onCountUp" text="Count Up" />

        <Button onAction="#onCountDown" text="Count Down" />

        <Button onAction="#onReset" text="Reset" />
    </children>
</HBox>
