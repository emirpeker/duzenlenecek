<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.DashboardController">

    <!-- Sol Menü -->
    <left>
        <VBox spacing="15" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Button text="Profil" fx:id="btnProfile" onAction="#openProfile"
                    style="-fx-pref-width: 120;"/>
            <Button text="Eğitim" fx:id="btnEducation" onAction="#openEducation"
                    style="-fx-pref-width: 120;"/>
            <Button text="Deneyim" fx:id="btnExperience" onAction="#openExperience"
                    style="-fx-pref-width: 120;"/>
            <Button text="Yetenekler" fx:id="btnSkills" onAction="#openSkills"
                    style="-fx-pref-width: 120;"/>
            <Button text="PDF Oluştur" fx:id="btnPdf" onAction="#openPdf"
                    style="-fx-pref-width: 120;"/>
        </VBox>
    </left>

    <!-- Sağ İçerik Alanı -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20;">
        </StackPane>
    </center>

</BorderPane>
