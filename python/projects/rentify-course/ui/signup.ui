  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: #ffffff;
    color: #000000;
}

QLabel#label {
    color: #000000;
    font-size: 26px;
    font-weight: bold;
    letter-spacing: 1px;
}

/* Genel label stili */
QLabel {
    color: #000000;
    font-size: 16px;
}

/* Input kutuları */
QLineEdit {
    background-color: #fafafa;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    color: #000000;
}

QLineEdit:focus {
    border: 1px solid #3b82f6;
    background-color: #ffffff;
}

/* Placeholder düzeltme */
QLineEdit::placeholder {
    color: #888888;
    font-size: 14px;
}

/* Sign Up butonu */
QPushButton#btn_register {
    background-color: #1e88e5;
    color: #ffffff;
    border-radius: 8px;
    border: none;
    height: 42px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#btn_register:hover {
    background-color: #166fcc;
}

QPushButton#btn_register:pressed {
    background-color: #0d47a1;
}
</string>
