  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: #ffffff;
}

/* Genel label stilleri */
QLabel {
    color: #222222;
    font-size: 14px;
}

/* Başlık (Login) */
QLabel#titleLabel {
    font-size: 26px;
    font-weight: bold;
    color: #000000;
}

/* Input alanları */
QLineEdit {
    background-color: #f2f2f2;
    border: 2px solid #dcdcdc;
    border-radius: 8px;
    padding: 8px;
    font-size: 14px;
    color: #000000;
}

QLineEdit:focus {
    border: 2px solid #377dff;
}

/* Login Butonu */
#btn_login {
    background-color: #1a73e8;
    color: #ffffff;
    border-radius: 8px;
    padding: 8px;
    font-size: 15px;
    font-weight: bold;
}

#btn_login:hover {
    background-color: #1668d8;
}

#btn_login:pressed {
    background-color: #0f4fb5;
}

/* &quot;Sign Up!&quot; link */
#label_5 {
    color: #1a73e8;
    font-weight: bold;
}

#label_5:hover {
    color: #4d90fe;
    text-decoration: underline;
}
</string>
